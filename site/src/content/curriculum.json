        "slug": "05_your-gpt-from-a-blank-file",
        "hasBreakIt": true,
        "hasOutputs": true
      },
      {
        "num": 6,
        "folder": "06_from-prototype-to-nanogpt",
        "title": "From Prototype to nanoGPT",
        "hook": "Two surgical refinements that turn the Project 5 prototype into a production-shape model: parameter groups for weight decay, and scaled residual initialization. Train both side-by-side and watch val loss drop by 0.7.",
        "summary": "side-by-side with the reference.",
        "slug": "06_from-prototype-to-nanogpt",
        "hasBreakIt": true,
        "hasOutputs": true
      },
      {
        "num": 7,
        "folder": "07_the-details-that-matter",
        "title": "The Details That Matter",
        "hook": "RMSNorm instead of LayerNorm. SwiGLU instead of GELU. The two architectural swaps that appear in Llama, Mistral, and most modern open-weight LLMs. Train all four combinations side-by-side and look at the deltas.",
        "summary": "norms, activations, positional encodings.",
        "slug": "07_the-details-that-matter",
        "hasBreakIt": true,
        "hasOutputs": true
      },
      {
        "num": 8,
        "folder": "08_flash-attention-and-tiled-kernels",
        "title": "Flash Attention and Tiled Kernels",
        "hook": "The actual idea behind FlashAttention is not a new algorithm. It's a different schedule for the same algorithm — one that never materializes the full (T, T) score matrix in memory. This project demonstrates the schedule on CPU with explicit memory accounting.",
        "summary": "memory-efficient attention.",
        "slug": "08_flash-attention-and-tiled-kernels",
        "hasBreakIt": true,
        "hasOutputs": true
      }
    ]
