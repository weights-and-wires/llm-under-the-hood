      {
        "num": 1,
        "folder": "01_the-learning-machine",
        "title": "The Learning Machine",
        "hook": "Build a scalar autograd engine yourself, train a tiny MLP on a 2D toy dataset, then deliberately break the gradient flow and watch learning stop cold.",
        "summary": "scalar autograd, neurons, MLP, training loop.",
        "slug": "01_the-learning-machine",
        "hasBreakIt": true,
        "hasOutputs": true
      },
      {
        "num": 2,
        "folder": "02_predicting-the-next-character",
        "title": "Predicting the Next Character",
        "hook": "The least mystical version of language modeling: a counting table vs. a tiny neural model with learned embeddings. Watch the neural model overfit a tiny corpus, then deliberately destroy its embeddings and see what fails.",
        "summary": "bigram counts → learned embeddings → NLL.",
        "slug": "02_predicting-the-next-character",
        "hasBreakIt": true,
        "hasOutputs": true
      },
      {
        "num": 3,
        "folder": "03_building-a-tokenizer",
        "title": "Building a Tokenizer",
        "hook": "Byte-Pair Encoding from scratch in ~80 lines. Train at multiple vocabulary sizes, visualize what gets merged, and watch the sweet spot emerge between \"everything is bytes\" and \"everything is rare fragments.\"",
        "summary": "BPE from scratch; vocab size as a tunable knob.",
        "slug": "03_building-a-tokenizer",
        "hasBreakIt": true,
        "hasOutputs": true
      },
      {
        "num": 4,
        "folder": "04_attention-from-scratch",
        "title": "Attention from Scratch",
        "hook": "Q/K/V projections, scaled dot products, causal masking, multi-head split — all written by hand with no `nn.MultiheadAttention` to paper over what's happening. Then watch the 1/√d_head scaling factor stop being optional.",
        "summary": "Q/K/V, scaled dot-product, masking, multi-head.",
        "slug": "04_attention-from-scratch",
        "hasBreakIt": true,
        "hasOutputs": true
      }
    ]
  },
  {
    "name": "Building a GPT",
    "slug": "building-a-gpt",
    "projects": [
      {
        "num": 5,
        "folder": "05_your-gpt-from-a-blank-file",
        "title": "Your GPT from a Blank File",
        "hook": "The smallest complete GPT: tokenizer → batches → transformer blocks → training loop → generation, in one file. Train it on Shakespeare-shaped text in 3 seconds on CPU.",
