---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { marked } from "marked";

import fs from "node:fs";
import path from "node:path";
const setupDir = path.resolve(process.cwd(), "src/content/setup");
const files = fs.existsSync(setupDir)
  ? fs.readdirSync(setupDir).filter((f) => f.endsWith(".json")).sort()
  : [];
const docs = files.map((f) => JSON.parse(fs.readFileSync(path.join(setupDir, f), "utf8")));
---

<BaseLayout active="/setup" title="Setup">
  <header class="page-head">
    <p class="eyebrow">Before you begin</p>
    <h1 class="page-title">Setup</h1>
    <p class="page-lede">
      Start with the file that matches your actual blocker. Most readers already have
      Python — the common stumbling blocks are <strong>GPU sizing</strong> and
      <strong>dataset access</strong>.
    </p>
  </header>

  <ol class="setup-list">
    {docs.map((doc) => (
      <li class="setup-item">
        <details>
          <summary>
            <span class="setup-file">{doc.filename}</span>
            <span class="setup-title">{doc.title}</span>
          </summary>
          <div class="prose setup-body" set:html={marked.parse(doc.body)} />
        </details>
      </li>
    ))}
  </ol>
</BaseLayout>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".prose pre").forEach((pre) => {
      if (pre.querySelector(".copy-btn")) return;
      const text = pre.textContent || "";
      const btn = document.createElement("button");
      btn.className = "copy-btn";
      btn.textContent = "Copy";
      btn.setAttribute("aria-label", "Copy code");
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = "Copied";
          btn.classList.add("copied");
          setTimeout(() => {
            btn.textContent = "Copy";
            btn.classList.remove("copied");
          }, 1400);
        } catch {
          /* clipboard blocked */
        }
      });
      pre.appendChild(btn);
    });
  });
</script>

<style>
  .page-head {
    margin-bottom: 3rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-faint);
    margin-bottom: 0.8rem;
  }
  .page-title {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    margin: 0 0 0.8rem;
    letter-spacing: -0.02em;
  }
  .page-lede {
    color: var(--color-muted);
    max-width: 60ch;
    line-height: 1.65;
  }
  .setup-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .setup-item {
    border-top: 1px solid var(--color-line);
  }
  .setup-item:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  .setup-item summary {
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
    padding: 1.1rem 0.4rem;
    cursor: pointer;
    list-style: none;
  }
  .setup-item summary::-webkit-details-marker {
    display: none;
  }
  .setup-file {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-accent);
    flex-shrink: 0;
    min-width: 0;
  }
  .setup-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-fg);
  }
  .setup-body {
    padding: 0 0.4rem 1.5rem;
    max-width: 700px;
  }
</style>
