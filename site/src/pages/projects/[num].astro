---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { codeToHtml } from "shiki";
import { marked } from "marked";

export async function getStaticPaths() {
  const projects = (await import("../../content/curriculum.json")).default;
  const paths = [];
  for (const part of projects) {
    for (const proj of part.projects) {
      paths.push({ params: { num: String(proj.num) } });
    }
  }
  return paths;
}

const { num } = Astro.params;
const data = (await import(`../../content/projects/${num}.json`)).default;

// Highlight all code blocks at build time with Shiki.
const highlight = (code, lang = "python") =>
  codeToHtml(code, {
    lang,
    theme: "github-dark-default",
    wrap: true,
  });

const buildHtml = data.files.build ? highlight(data.files.build.content) : null;
const breakHtml = data.files.breakIt ? highlight(data.files.breakIt.content) : null;
const stepHtml = data.files.steps.map((s) => ({
  ...s,
  html: highlight(s.content),
}));

// find the markdown sections we want to render as prose
const findSection = (heading) =>
  data.sections.find(
    (s) => s.heading.toLowerCase() === heading.toLowerCase() || s.slug.toLowerCase().includes(heading.toLowerCase().replace(/\s+/g, "-"))
  );
const conceptSection = findSection("The Concept");
const whySection = findSection("Why It Matters");
const outputsSection = data.sections.find((s) => /outputs/i.test(s.heading));
const breakResultSection = data.sections.find((s) => /break it/i.test(s.heading));

// prev / next project navigation
const allNums = (await import("../../content/curriculum.json")).default
  .flatMap((p) => p.projects)
  .map((p) => p.num);
const idx = allNums.indexOf(Number(num));
const prev = idx > 0 ? allNums[idx - 1] : null;
const next = idx < allNums.length - 1 ? allNums[idx + 1] : null;

import book from "../../content/book.json";
---

<BaseLayout active={`/projects/${num}`} title={`${data.title}`}>
  <div class="progress-bar" id="progress-bar"></div>
  <article class="project">
    <header class="proj-head">
      <div class="proj-crumb">
        <a href="/projects">Projects</a>
        <span>/</span>
        <span>{data.part.name}</span>
      </div>
      <span class="proj-num-big">Project {String(data.num).padStart(2, "0")}</span>
      <h1 class="proj-h1">{data.title}</h1>
      {data.summary && <p class="proj-one-line">{data.summary}</p>}
      {data.hook && <blockquote class="proj-hook">{data.hook}</blockquote>}
    </header>

    {conceptSection && (
      <section class="proj-section">
        <h2 class="proj-h2">The Concept</h2>
        <div class="prose" set:html={marked.parse(conceptSection.body)} />
      </section>
    )}

    {whySection && (
      <section class="proj-section">
        <h2 class="proj-h2">Why It Matters</h2>
        <div class="prose" set:html={marked.parse(whySection.body)} />
      </section>
    )}

    {buildHtml && (
      <section class="proj-section">
        <div class="proj-section-head">
          <h2 class="proj-h2">The Build</h2>
          <span class="proj-file-label">build.py</span>
        </div>
        <p class="proj-run">
          <span class="prompt">$</span>
          <code>python projects/{data.folder}/build.py --tiny</code>
        </p>
        <div class="codeframe" set:html={buildHtml} />
      </section>
    )}

    {stepHtml.length > 0 && (
      <section class="proj-section">
        <div class="proj-section-head">
          <h2 class="proj-h2">The Steps</h2>
          <span class="proj-file-label">{stepHtml.length} reference files</span>
        </div>
        <p class="proj-steps-note">
          Each step is the code for one piece, in isolation — read them as the book
          introduces them. They assemble into <code>build.py</code> above.
        </p>
        <div class="steps">
          {stepHtml.map((s, i) => (
            <details class="step" open={i === 0}>
              <summary>
                <span class="step-num">Step {String(s.n).padStart(2, "0")}</span>
                <span class="step-title">{s.title}</span>
                <span class="step-file">{s.name}</span>
              </summary>
              <div class="codeframe" set:html={s.html} />
            </details>
          ))}
        </div>
      </section>
    )}

    {breakHtml && (
      <section class="proj-section proj-break">
        <div class="proj-section-head">
          <h2 class="proj-h2">Break It</h2>
          <span class="proj-file-label proj-file-label--warn">break_it.py</span>
        </div>
        {breakResultSection && (
          <div class="prose" set:html={marked.parse(breakResultSection.body)} />
        )}
        <p class="proj-run">
          <span class="prompt">$</span>
          <code>python projects/{data.folder}/break_it.py --tiny</code>
        </p>
        <div class="codeframe" set:html={breakHtml} />
      </section>
    )}

    {data.outputs.length > 0 && (
      <section class="proj-section">
        <h2 class="proj-h2">Outputs</h2>
        <div class="outputs">
          {data.outputs.map((o) => (
            <div class="output">
              {o.kind === "image" ? (
                <figure>
                  <img src={`/outputs/${data.num}/${o.name}`} alt={o.name} loading="lazy" />
                  <figcaption>{o.name}</figcaption>
                </figure>
              ) : (
                <div class="output-text">
                  <div class="output-text-head">{o.name}</div>
                  <pre><code>{o.content}</code></pre>
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="proj-section proj-book-cta">
      <h2 class="proj-h2">Read it in the book</h2>
      <p>
        This page ships the code. The full derivation — why the chain rule is mechanical
        not magical, what the computational graph buys you, the long-form reasoning —
        lives in Chapter {data.num} of <em>{book.title}</em>.
      </p>
      <a href={book.leanpubUrl} target="_blank" rel="noopener" class="btn btn-primary">
        Get the book →
      </a>
    </section>

    <nav class="proj-pager">
      {prev !== null ? (
        <a href={`/projects/${prev}`} class="pager pager-prev">
          <span class="pager-label">← Previous</span>
          <span class="pager-num">Project {String(prev).padStart(2, "0")}</span>
        </a>
      ) : <span />}
      {next !== null ? (
        <a href={`/projects/${next}`} class="pager pager-next">
          <span class="pager-label">Next →</span>
          <span class="pager-num">Project {String(next).padStart(2, "0")}</span>
        </a>
      ) : <span />}
    </nav>
  </article>
</BaseLayout>

<style>
  .project {
    max-width: 820px;
  }
  .proj-head {
    margin-bottom: 3rem;
  }
  .proj-crumb {
    font-size: 0.76rem;
    color: var(--color-faint);
    font-family: var(--font-mono);
    margin-bottom: 1.5rem;
    display: flex;
    gap: 0.5rem;
  }
  .proj-crumb a {
    color: var(--color-muted);
    text-decoration: none;
  }
  .proj-crumb a:hover {
    color: var(--color-accent);
  }
  .proj-num-big {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-accent);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .proj-h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0.4rem 0 0.8rem;
  }
  .proj-one-line {
    color: var(--color-muted);
    font-size: 1.05rem;
    max-width: 60ch;
    line-height: 1.5;
    margin-bottom: 1.2rem;
  }
  .proj-hook {
    border-left: 2px solid var(--color-accent-dim);
    padding: 0.3rem 0 0.3rem 1.1rem;
    color: var(--color-muted);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
  }

  .proj-section {
    margin-top: 3rem;
  }
  .proj-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .proj-h2 {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .proj-file-label {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--color-muted);
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 4px;
  }
  .proj-file-label--warn {
    color: #d4a55a;
    border-color: #4a3a22;
    background: rgba(212, 165, 90, 0.06);
  }

  .proj-run {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-fg);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 5px;
    padding: 0.6rem 0.9rem;
    margin: 0 0 1.2rem;
    overflow-x: auto;
  }
  .proj-run .prompt {
    color: var(--color-accent);
  }

  .codeframe {
    border: 1px solid var(--color-line);
    border-radius: 6px;
    overflow: hidden;
    margin: 1rem 0;
  }
  .codeframe :global(pre) {
    margin: 0;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.6;
    background: var(--color-surface) !important;
  }
  .codeframe :global(code) {
    font-family: var(--font-mono);
  }

  /* steps accordion */
  .proj-steps-note {
    color: var(--color-muted);
    font-size: 0.88rem;
    margin-bottom: 1.2rem;
  }
  .steps {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .step {
    border: 1px solid var(--color-line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-surface);
  }
  .step summary {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 1rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .step summary::-webkit-details-marker {
    display: none;
  }
  .step[open] summary {
    border-bottom: 1px solid var(--color-line);
  }
  .step-num {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }
  .step-title {
    font-size: 0.92rem;
    color: var(--color-fg);
    flex: 1;
  }
  .step-file {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-faint);
  }
  .step .codeframe {
    border: none;
    border-radius: 0;
    margin: 0;
  }

  /* outputs */
  .outputs {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .output figure {
    margin: 0;
  }
  .output img {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background: var(--color-surface);
  }
  .output figcaption {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-faint);
    margin-top: 0.5rem;
  }
  .output-text {
    border: 1px solid var(--color-line);
    border-radius: 6px;
    overflow: hidden;
  }
  .output-text-head {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-muted);
    padding: 0.5rem 0.9rem;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-surface-2);
  }
  .output-text pre {
    margin: 0;
    padding: 1rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-fg);
  }

  .proj-book-cta {
    border-top: 1px solid var(--color-line);
    padding-top: 2rem;
  }
  .proj-book-cta p {
    color: var(--color-muted);
    line-height: 1.65;
    margin-bottom: 1.2rem;
    max-width: 60ch;
  }
  .btn {
    display: inline-block;
    padding: 0.65rem 1.2rem;
    border-radius: 5px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .btn-primary {
    background: var(--color-accent);
    color: #0a0a0b;
  }
  .btn-primary:hover {
    background: color-mix(in srgb, var(--color-accent) 85%, white);
  }

  .proj-pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .pager {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .pager-next {
    text-align: right;
    margin-left: auto;
  }
  .pager-label {
    font-size: 0.78rem;
    color: var(--color-faint);
  }
  .pager-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-accent);
  }
  .progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: var(--color-accent);
    z-index: 100;
    transition: width 0.05s linear;
  }
  .codeframe { position: relative; }
  .copy-btn--float {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 2;
    background: color-mix(in srgb, var(--color-surface-2) 80%, transparent);
    border: 1px solid var(--color-line-strong);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.12s ease, color 0.12s ease, border-color 0.12s ease;
  }
  .codeframe:hover .copy-btn--float {
    opacity: 1;
  }
  .copy-btn--float:hover {
    color: var(--color-fg);
    border-color: var(--color-accent-dim);
  }
  .copy-btn--float.copied {
    opacity: 1;
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>

<script>
  // Reading progress bar
  const updateProgress = () => {
    const bar = document.getElementById("progress-bar");
    if (!bar) return;
    const h = document.documentElement;
    const scrolled = h.scrollTop;
    const total = h.scrollHeight - h.clientHeight;
    bar.style.width = (total > 0 ? (scrolled / total) * 100 : 0) + "%";
  };
  window.addEventListener("scroll", updateProgress, { passive: true });
  window.addEventListener("DOMContentLoaded", updateProgress);

  // Inject copy buttons into every code frame AND prose pre blocks.
  window.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll(".codeframe").forEach((frame) => {
      if (frame.querySelector(":scope > .copy-btn")) return;
      const pre = frame.querySelector("pre");
      if (!pre) return;
      const text = pre.textContent || "";
      const btn = document.createElement("button");
      btn.className = "copy-btn copy-btn--float";
      btn.textContent = "Copy";
      btn.setAttribute("aria-label", "Copy code");
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = "Copied";
          btn.classList.add("copied");
          setTimeout(() => {
            btn.textContent = "Copy";
            btn.classList.remove("copied");
          }, 1400);
        } catch {
          /* clipboard blocked */
        }
      });
      frame.appendChild(btn);
    });

    // Add copy buttons to prose code blocks
    document.querySelectorAll(".prose pre").forEach((pre) => {
      if (pre.querySelector(".copy-btn")) return;
      const text = pre.textContent || "";
      const btn = document.createElement("button");
      btn.className = "copy-btn";
      btn.textContent = "Copy";
      btn.setAttribute("aria-label", "Copy code");
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = "Copied";
          btn.classList.add("copied");
          setTimeout(() => {
            btn.textContent = "Copy";
            btn.classList.remove("copied");
          }, 1400);
        } catch {
          /* clipboard blocked */
        }
      });
      pre.appendChild(btn);
    });
  });
</script>
