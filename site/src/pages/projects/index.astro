---
import BaseLayout from "../../layouts/BaseLayout.astro";
const parts = (await import("../../content/curriculum.json")).default;
const totalProjects = parts.reduce((n, p) => n + p.projects.length, 0);
---

<BaseLayout active="/projects" title="All Projects">
  <header class="page-head">
    <p class="eyebrow">{parts.length} parts · {totalProjects} projects</p>
    <h1 class="page-title">All Projects</h1>
    <p class="page-lede">
      Every project ships a runnable <code>build.py</code>, a <code>break_it.py</code>
      sabotage experiment, and captured outputs. Read in order — each builds on the last.
    </p>
  </header>

  {parts.map((part) => (
    <section class="part-block">
      <div class="part-header">
        <h2 class="part-title">{part.name}</h2>
        <span class="part-count">{part.projects.length} projects</span>
      </div>
      <ul class="proj-list">
        {part.projects.map((p) => (
          <li>
            <a href={`/projects/${p.num}`} class="proj-card">
              <span class="proj-num">{String(p.num).padStart(2, "0")}</span>
              <span class="proj-body">
                <span class="proj-title">{p.title}</span>
                {p.summary && <span class="proj-summary">{p.summary}</span>}
              </span>
              <span class="proj-tags">
                <span class:list={["tag", p.hasBreakIt ? "tag-break" : "tag-off"]}>break</span>
                <span class:list={["tag", p.hasOutputs ? "tag-out" : "tag-off"]}>outputs</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 3rem;
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-faint);
    margin-bottom: 0.8rem;
  }
  .page-title {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    margin: 0 0 0.8rem;
    letter-spacing: -0.02em;
  }
  .page-lede {
    color: var(--color-muted);
    max-width: 55ch;
    line-height: 1.6;
  }

  .part-block {
    margin-bottom: 3rem;
  }
  .part-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.6rem;
    margin-bottom: 0.5rem;
  }
  .part-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    margin: 0;
  }
  .part-count {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-faint);
  }
  .proj-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .proj-card {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0.4rem;
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.1s ease;
  }
  .proj-card:hover {
    background: var(--color-surface);
  }
  .proj-num {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-accent);
  }
  .proj-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .proj-title {
    font-size: 1rem;
    color: var(--color-fg);
  }
  .proj-summary {
    font-size: 0.82rem;
    color: var(--color-muted);
    line-height: 1.5;
  }
  .proj-tags {
    display: flex;
    gap: 0.4rem;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    padding: 0.12rem 0.45rem;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .tag-break {
    color: #d4a55a;
    border: 1px solid #4a3a22;
    background: rgba(212, 165, 90, 0.06);
  }
  .tag-out {
    color: var(--color-accent);
    border: 1px solid var(--color-accent-dim);
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
  }
  .tag-off {
    display: none;
  }

  @media (max-width: 600px) {
    .proj-card {
      grid-template-columns: 2rem 1fr;
    }
    .proj-tags {
      display: none;
    }
  }
</style>
