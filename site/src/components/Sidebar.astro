---
import book from "../content/book.json";

interface Props {
  active?: string;
}
const { active = "" } = Astro.props;

const parts = (await import("../content/curriculum.json")).default;
---

<aside class="sidebar">
  <a href="/" class="brand">
    <span class="brand-mark">UTH</span>
    <span class="brand-text">
      <span class="brand-title">Under the Hood</span>
      <span class="brand-sub">Build · Break · Measure</span>
    </span>
  </a>

  <nav class="nav">
    <a href="/projects" class:list={["nav-link", "nav-top", active === "/projects" && "is-active"]}>
      All Projects
    </a>

    <div class="nav-sections">
      {parts.map((part) => (
        <div class="nav-part">
          <div class="nav-part-name">{part.name}</div>
          <ul>
            {part.projects.map((p) => (
              <li>
                <a
                  href={`/projects/${p.num}`}
                  class:list={["nav-project", active === `/projects/${p.num}` && "is-active"]}
                >
                  <span class="nav-num">{String(p.num).padStart(2, "0")}</span>
                  <span class="nav-title">{p.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="nav-divider"></div>
    <a href="/setup" class:list={["nav-link", "nav-top", active === "/setup" && "is-active"]}>
      Setup
    </a>
    <a href="/about" class:list={["nav-link", "nav-top", active === "/about" && "is-active"]}>
      About
    </a>
  </nav>

  <div class="sidebar-foot">
    <a href={book.leanpubUrl} target="_blank" rel="noopener" class="cta-book">
      Get the book →
    </a>
    <a href={book.githubUrl} target="_blank" rel="noopener" class="cta-repo">
      GitHub
    </a>
  </div>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    align-self: start;
    width: 264px;
    height: 100vh;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--color-line);
    background: var(--color-bg);
    overflow-y: auto;
    overflow-x: hidden;
    padding: 1.5rem 0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0 1.25rem 1.25rem;
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
  }
  .brand-mark {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    border: 1px solid var(--color-line-strong);
    padding: 0.3rem 0.4rem;
    border-radius: 4px;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-title {
    font-family: var(--font-serif);
    font-size: 0.98rem;
    color: var(--color-fg);
  }
  .brand-sub {
    font-size: 0.68rem;
    color: var(--color-faint);
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }

  .nav {
    flex: 1;
    padding: 1rem 0.5rem 1.5rem;
  }
  .nav-top {
    display: block;
    padding: 0.4rem 0.75rem;
    font-size: 0.85rem;
    color: var(--color-muted);
    text-decoration: none;
    border-radius: 4px;
  }
  .nav-top:hover {
    color: var(--color-fg);
    background: var(--color-surface);
  }
  .nav-top.is-active {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .nav-sections {
    margin-top: 0.75rem;
  }
  .nav-part {
    margin-bottom: 0.9rem;
  }
  .nav-part-name {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-faint);
    padding: 0.5rem 0.75rem 0.3rem;
    font-family: var(--font-sans);
  }
  .nav-part ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-project {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.28rem 0.75rem;
    text-decoration: none;
    border-radius: 4px;
    line-height: 1.3;
  }
  .nav-project:hover {
    background: var(--color-surface);
  }
  .nav-project.is-active {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }
  .nav-project.is-active .nav-title {
    color: var(--color-fg);
  }
  .nav-project.is-active .nav-num {
    color: var(--color-accent);
  }
  .nav-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-faint);
    flex-shrink: 0;
    min-width: 1.5rem;
  }
  .nav-title {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .nav-project:hover .nav-title {
    color: var(--color-fg);
  }

  .nav-divider {
    height: 1px;
    background: var(--color-line);
    margin: 0.75rem 0.75rem;
  }

  .sidebar-foot {
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1rem;
  }
  .cta-book {
    display: block;
    text-align: center;
    text-decoration: none;
    font-size: 0.82rem;
    padding: 0.55rem;
    border-radius: 4px;
    background: var(--color-accent);
    color: #0a0a0b;
    font-weight: 600;
  }
  .cta-book:hover {
    background: color-mix(in srgb, var(--color-accent) 85%, white);
  }
  .cta-repo {
    display: block;
    text-align: center;
    text-decoration: none;
    font-size: 0.78rem;
    color: var(--color-muted);
    padding: 0.3rem;
  }
  .cta-repo:hover {
    color: var(--color-fg);
  }

  /* mobile drawer */
  @media (max-width: 900px) {
    .sidebar {
      position: fixed;
      z-index: 50;
      width: 264px;
      transform: translateX(-100%);
      transition: transform 0.2s ease;
    }
    .sidebar.is-open {
      transform: translateX(0);
    }
  }
</style>

<script>
  // mobile drawer toggle (the topbar hamburger flips this)
  window.addEventListener("DOMContentLoaded", () => {
    const sb = document.querySelector(".sidebar");
    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t.closest("[data-menu-toggle]")) {
        sb?.classList.toggle("is-open");
        return;
      }
      if (!t.closest(".sidebar") && sb?.classList.contains("is-open")) {
        sb.classList.remove("is-open");
      }
    });
  });
</script>
